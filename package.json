{
  "name": "jevprune",
  "version": "0.2.0",
  "description": "Prunes long Bash results per line before the model reads them, and recovers dropped ranges by run id.",
  "license": "MIT",
  "author": "ibrahemid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahemid/jevprune.git"
  },
  "homepage": "https://github.com/ibrahemid/jevprune#readme",
  "bugs": {
    "url": "https://github.com/ibrahemid/jevprune/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jevprune": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "tsup --config tsup.bench.config.ts && node .bench/run.js",
    "gate": "scripts/gate.sh",
    "prepublishOnly": "scripts/gate.sh && tsup"
  },
  "keywords": [
    "claude-code",
    "typesafe",
    "jev",
    "cli",
    "context",
    "tokens",
    "output",
    "pruning",
    "plugin",
    "hooks"
  ],
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
